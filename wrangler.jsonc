{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-17",
  "env": {
    // Staging Environment
    "staging": {
      "name": "ihod-server-staging",
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          // 60 requests per minute
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
    },
    //  Production Environment
    "production": {
      "name": "acorp-invoice-server-production",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "13dc29eeac9148c9935ea2b84d48bb67",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "acorp-r2-bucket",
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
      "triggers": {
        "crons": ["* * * * *", "0 0 1 * *"],
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          // 60 requests per minute
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
    },
    // UAT Environment
    "uat": {
      "name": "ihod-server-uat",
    },
    // Development Environment
    "dev": {
      "name": "acorp-invoice-server-dev",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "1f8655c623744ba7a87dde09997d204b",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "acorp-r2-bucket",
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
      "triggers": {
        "crons": ["* * * * *", "0 0 1 * *"],
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          // 60 requests per minute
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
    },
  },
  "dev": {
    "port": 8585,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1, // optional. default = 1.
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true,
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "13dc29eeac9148c9935ea2b84d48bb67",
      "localConnectionString": "postgresql://user:password@localhost:5432/databasename",
    },
  ],

  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "my-database",
  //     "database_id": "",
  //   },
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
